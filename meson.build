  include_directories : incs,
  c_args : c_args,
  dependencies : deps)

run_target('run', command : [exe])

test('boot-to-title', exe,
  args : ['--frames', '900', '--mute'],
  env : ['SDL_VIDEODRIVER=offscreen', 'SDL_AUDIODRIVER=dummy'],
  timeout : 120)
