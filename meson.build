  version : '1.0',
  meson_version : '>=0.56.0',
  default_options : ['c_std=c99', 'warning_level=2', 'buildtype=debugoptimized'])

cc = meson.get_compiler('c')

deps = [
  dependency('sdl2'),
  dependency('SDL2_image'),
  dependency('SDL2_ttf'),
  dependency('SDL2_mixer'),
  cc.find_library('m', required : false),
]

assets_dir = get_option('assets_dir')
if assets_dir == ''
  assets_dir = meson.current_source_dir() / 'assets'
endif
data_dir = get_option('data_dir')
if data_dir == ''
  data_dir = meson.current_source_dir() / 'data'
endif

c_args = [
  '-DGM_USE_GAME_CONFIG',
  '-DSP_DEFAULT_ASSETS_DIR="' + assets_dir + '"',
  '-DSP_DEFAULT_DATA_DIR="' + data_dir + '"',
]

